{
  "expo": {
    "name": "SOLIN",
    "slug": "solin-mobile",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-solin.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D6B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.solin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D6B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.solin",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O SOLIN precisa acessar suas fotos para o cadastro do pet."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2E7D6B"
        }
      ]
    ],
    "extra": {
      "apiUrlProducao": "https://solin-api-production.up.railway.app",
      "repositorio": "https://github.com/Nickolas0506/Challenge---Mobile-Application-Development"
    }
  }
}
